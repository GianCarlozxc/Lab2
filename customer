import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;
import java.util.*;
import javax.swing.*;


public class Mavenproject6 extends JFrame implements ActionListener{
    
    private JLabel label;
    private JTextField txt;
    private JButton add, pick, show;
    private JScrollPane scroll;
    private JList<String> list;
    private DefaultListModel<String> listmodel;
    private Queue<String> queue;
    
Mavenproject6(){
    
    queue = new LinkedList<>();
    listmodel = new DefaultListModel<>();
    
    setTitle("Customer Service");
    setSize(600, 300);
    setLayout(null);
    setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
    
    label = new JLabel("Enter Customer Name");
    label.setBounds(50, 30, 150, 30);
    add(label);
    
    txt = new JTextField();
    txt.setBounds(225, 30, 300, 30);
    add(txt);
    
    add = new JButton("Add Customer");
    add.setBounds(50, 70, 150, 25);
    add(add);
    
    pick = new JButton("Serve Custome");
    pick.setBounds(50, 120, 150, 25);
    add(pick);
    
    show = new JButton("Show Queue");
    show.setBounds(50, 170, 150, 25);
    add(show);
    
    list = new JList<>(listmodel);
    scroll = new JScrollPane(list);
    scroll.setBounds(225, 70, 300, 150);
    add(scroll);
            
    add.addActionListener(this);
    pick.addActionListener(this);
    show.addActionListener(this);
            
           
}

    @Override
    public void actionPerformed(ActionEvent e) {
        if(e.getSource() == add){
            String name = txt.getText();
        
            if(!name.isEmpty()){
                queue.add(name);
                txt.setText("");
                JOptionPane.showMessageDialog(this, "Customer name is "+name);
            }
            else{
                JOptionPane.showMessageDialog(this, "Enter Custome Name", "Error", JOptionPane.ERROR_MESSAGE);
            }
    }
        else if(e.getSource() == pick){
          if(!queue.isEmpty()){
              String get = queue.poll();
              JOptionPane.showMessageDialog(this, "Serving Customer " +get);
          }
          else{
              JOptionPane.showMessageDialog(this, "No Customer", "Error", JOptionPane.ERROR_MESSAGE);
              
          }
        }
        else if(e.getSource() == show){
            if(!queue.isEmpty()){
            listmodel.clear();
            for(String name: queue){
                listmodel.addElement(name); 
            }
        }
            else{
                    JOptionPane.showMessageDialog(this, "Empty Queue", "Info", JOptionPane.INFORMATION_MESSAGE);
                    listmodel.clear();
                    }
            
        }
            
        }

   
    }
