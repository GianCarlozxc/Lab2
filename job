
package lab2practice;

import java.util.LinkedList;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;
import java.awt.Font;
import javax.swing.*;

public class Job extends JFrame implements ActionListener {

    private JTextField txtInput;
    private DefaultListModel<String> listModel;
    private JList<String> listTask;
    private JScrollPane scrollPane;
    private JButton btnAdd, btnRemove, btnCompleted, btnClear, btnShow;
    private LinkedList<String> linkedList;

    Job() {
        // Dito binabago ang title ng application
        setTitle("JOB MANAGEMENT GUI");

        // Dito ina-adjust ang laki ng buong window
        // setSize(width, height)
        setSize(550, 500);

        // Manual positioning ng mga components
        setLayout(null);

        // Para mag-close ang program kapag sinara ang window
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);

        // TEXT FIELD
        txtInput = new JTextField();

        // Dito ina-adjust ang position at size ng input field
        // setBounds(x, y, width, height)
        txtInput.setBounds(50, 50, 450, 30);
        txtInput.setFont(new Font("Segoe UI", Font.PLAIN, 12));
        add(txtInput);

        // Frontend list model
        // Dito naka-store ang mga job na nakikita sa GUI
        listModel = new DefaultListModel<>();

        // Backend LinkedList
        // Dito naka-store ang mga job sa LinkedList
        linkedList = new LinkedList<>();

        // JList
        listTask = new JList<>(listModel);
        listTask.setFont(new Font("Segoe UI", Font.PLAIN, 12));
        listTask.setSelectionMode(
            ListSelectionModel.SINGLE_SELECTION
        );

        // SCROLL PANE
        scrollPane = new JScrollPane(listTask);

        // Dito ina-adjust ang position at size ng listahan
        scrollPane.setBounds(50, 100, 450, 250);
        add(scrollPane);

        // setBounds(x, y, width, height)
        //
        // x      = pakanan o pakaliwa ang button
        // y      = pataas o pababa ang button
        // width  = lapad ng button
        // height = taas ng button

        // ADD BUTTON
        btnAdd = new JButton("Add");
        btnAdd.setBounds(50, 400, 85, 30);
        add(btnAdd);

        // SHOW BUTTON
        btnShow = new JButton("Show");
        btnShow.setBounds(141, 400, 85, 30);
        add(btnShow);

        // REMOVE BUTTON
        btnRemove = new JButton("Remove");
        btnRemove.setBounds(232, 400, 85, 30);
        add(btnRemove);

        // COMPLETED BUTTON
        btnCompleted = new JButton("Completed");
        btnCompleted.setBounds(323, 400, 95, 30);
        add(btnCompleted);

        // CLEAR BUTTON
        btnClear = new JButton("Clear");
        btnClear.setBounds(424, 400, 76, 30);
        add(btnClear);

        // ADD FUNCTION
        // Kapag pinindot ang Add, mase-save ang job
        btnAdd.addActionListener(this);

        // SHOW FUNCTION
        // Ipapakita ang mga naka-save na job
        btnShow.addActionListener(this);

        // REMOVE FUNCTION
        // Tatanggalin ang napiling job
        btnRemove.addActionListener(this);

        // COMPLETED FUNCTION
        // Lalagyan ng Completed ang napiling job
        btnCompleted.addActionListener(this);

        // CLEAR FUNCTION
        // Buburahin ang lahat ng job
        btnClear.addActionListener(this);
    }

    @Override
    public void actionPerformed(ActionEvent e) {

        if (e.getSource() == btnAdd) {
            String task = txtInput.getText().trim();

            // Hindi magdadagdag kapag walang text
            if (!task.isEmpty()) {

                // Idadagdag sa backend LinkedList
                linkedList.add(task);

                // Hindi muna ipapakita sa GUI
                // Show button lamang ang magpapakita

                // Lilinisin ang input field
                txtInput.setText("");

            } else {
                JOptionPane.showMessageDialog(
                    this,
                    "Enter job first before adding",
                    "Error Message",
                    JOptionPane.ERROR_MESSAGE
                );
            }
        }

        // SHOW FUNCTION USING FOR-EACH
        else if (e.getSource() == btnShow) {

            // Lilinisin muna para hindi madoble
            listModel.clear();

            // FOR-EACH LOOP
            // Ipapakita ang lahat ng naka-save na job
            for (String task : linkedList) {
                listModel.addElement(task);
            }
        }

        else if (e.getSource() == btnRemove) {
            int index = listTask.getSelectedIndex();

            // Titingnan kung may napiling job
            if (index != -1) {

                // Tatanggalin sa backend LinkedList
                linkedList.remove(index);

                // Tatanggalin sa GUI listahan
                listModel.remove(index);

            } else {
                JOptionPane.showMessageDialog(
                    this,
                    "Select job first before removing",
                    "Error Message",
                    JOptionPane.ERROR_MESSAGE
                );
            }
        }

        else if (e.getSource() == btnCompleted) {
            int index = listTask.getSelectedIndex();

            // Titingnan kung may napiling job
            if (index != -1) {
                String task = linkedList.get(index);

                // Para hindi maulit ang Completed
                if (!task.endsWith(" (Completed)")) {
                    String completedTask = task + " (Completed)";

                    // I-update ang backend LinkedList
                    linkedList.set(index, completedTask);

                    // I-update ang GUI listahan
                    listModel.set(index, completedTask);
                }

                listTask.clearSelection();

            } else {
                JOptionPane.showMessageDialog(
                    this,
                    "Please select a job first!",
                    "No Job Selected",
                    JOptionPane.WARNING_MESSAGE
                );
            }
        }

        else if (e.getSource() == btnClear) {

            // Buburahin ang lahat sa backend LinkedList
            linkedList.clear();

            // Buburahin ang lahat sa GUI listahan
            listModel.clear();
        }
    }

    public static void main(String[] args) {

        // Dito magsisimula ang Java Swing application
        SwingUtilities.invokeLater(() -> {
            Job window = new Job();

            // Ipapakita ang application window
            window.setLocationRelativeTo(null);
            window.setVisible(true);
        });
    }
}
